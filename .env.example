# Copy to .env and fill in. Everything here is optional: with none of it set the
# game runs exactly as it does today — guests type a name and play, with no
# database and no sign-in.

# --- Sign in with Discord ------------------------------------------------
# Create an application at https://discord.com/developers/applications, then
# under OAuth2 add a redirect URI matching DISCORD_REDIRECT_URI below.
# Without these two the auth routes answer 503 and the sign-in button is
# hidden rather than offered and broken.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# --- Persistence ---------------------------------------------------------
# Unset means profiles, chips and history live in memory and vanish on
# restart. The game still works; nothing is kept.
MONGO_URL=

# --- Sessions ------------------------------------------------------------
# Set this to anything long and random in production.
SESSION_SECRET=change-me

# --- Where things live ---------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
